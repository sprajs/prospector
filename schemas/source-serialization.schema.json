{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reviewed scalar source serialization",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "serialization_id", "title", "review_id", "source_assets", "scalars", "conventions", "unknowns", "qualification"],
  "properties": {
    "schema_version": {"const": 1},
    "serialization_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "title": {"type": "string", "minLength": 1},
    "review_id": {"type": "string", "minLength": 1},
    "source_assets": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "title", "url", "sha256", "retrieved_utc", "source_version", "coverage", "unread"],
      "properties": {"id": {"type": "string"}, "url": {"type": "string", "format": "uri"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "retrieved_utc": {"type": "string", "format": "date-time"}, "source_version": {"type": ["string", "null"]}, "coverage": {"type": "string", "minLength": 1}}
    }},
    "scalars": {"type": "array", "minItems": 1, "items": {
      "type": "object", "required": ["id", "decimal_value", "unit", "value_class", "source_asset_ids", "locator", "uncertainty", "model_choice"],
      "properties": {
        "id": {"type": "string"}, "decimal_value": {"type": "string", "pattern": "^-?[0-9]+(\\.[0-9]+)?([eE][+-]?[0-9]+)?$"}, "unit": {"type": "string", "minLength": 1},
        "value_class": {"enum": ["exact_definition", "evaluated_codata_central", "nist_asd_central", "reported_compilation_value"]},
        "source_asset_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}, "locator": {"type": "string", "minLength": 1},
        "uncertainty": {"type": "object", "required": ["decimal_value", "interpretation", "distribution", "coverage", "reason"], "properties": {"decimal_value": {"type": ["string", "null"]}, "interpretation": {"type": ["string", "null"]}, "distribution": {"type": ["string", "null"]}, "coverage": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}}},
        "model_choice": {"type": "string", "minLength": 1}
      }
    }},
    "conventions": {"type": "object"},
    "unknowns": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "qualification": {"type": "object", "additionalProperties": false, "required": ["numerically_executed", "scientifically_qualified"], "properties": {"numerically_executed": {"const": false}, "scientifically_qualified": {"const": false}}}
  }
}
